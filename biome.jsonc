{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "extends": ["@ivangabriele/biome-config"],
  "files": {
    "includes": ["!.vscode-test/**/*", "!.yarn/**/*", "!node_modules/**/*"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
