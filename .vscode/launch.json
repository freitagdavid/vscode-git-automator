{
  "configurations": [
    {
      "args": ["--extensionDevelopmentPath=${workspaceRoot}"],
      "name": "Extension",
      "outFiles": ["${workspaceRoot}/out/**/*.js"],
      "preLaunchTask": "npm: watch",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "sourceMaps": true,
      "stopOnEntry": false,
      "type": "extensionHost"
    },
    {
      "args": ["--extensionDevelopmentPath=${workspaceRoot}"],
      "name": "Extension (prod)",
      "preLaunchTask": "npm: compile",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "sourceMaps": false,
      "stopOnEntry": false,
      "type": "extensionHost"
    }
  ],
  "version": "0.2.0"
}
